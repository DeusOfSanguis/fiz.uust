{
  "name": "pacer-log",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:copy": "npm run build && npx cap copy android",
    "apk": "npm run build && npx cap copy android && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run build && npx cap copy android && cd android && ./gradlew assembleRelease",
    "icons:android": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Журнал тренировок из Pacer: ссылка → дата, километраж, время → Excel"
}
